[colors-dark]
foreground=29cc52
background=020d06
selection-foreground=a0ccad
selection-background=0e4320

cursor=020d06 29cc52

# Frosted, not see-through. This value was never the problem -- the rain read
# through at 0.92 because `blur` below was off, not because the glass was thin.
# With blur on, the little alpha left here is what lets the backdrop tint the
# console at all; drop it toward 0.86 for more glow, push it to 0.96 for flatter
# paint. `default` keeps only the empty background cells translucent, so
# highlighted text stays solid.
alpha=0.92
alpha-mode=default

# foot opts out of compositor blur by default: it speaks ext-background-effect-v1
# and, unless this is set, tells Hyprland to leave its surface alone. That is why
# decoration:blur in hyprland.lua frosted every other window but left the rain
# behind the terminal pin-sharp at any blur size.
blur=yes

regular0=020d06
regular1=00a028
regular2=00cc34
regular3=3ecc62
regular4=00934a
regular5=2ecc6d
regular6=00b36e
regular7=29cc52

bright0=1a5b30
bright1=31cc56
bright2=52cc70
bright3=6ecc86
bright4=3ecc80
bright5=70cc93
bright6=4acc9a
bright7=a0ccad
